{
  "name": "tauri-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "web:dev": "vite --host 0.0.0.0 --port 5175",
    "web:build": "tsc && vite build",
    "web:preview": "vite preview --host 0.0.0.0 --port 5175",
    "test:recall": "esbuild src/services/projectRecall.test.ts --bundle --platform=node --format=esm | node --input-type=module",
    "test:project": "esbuild src/services/projectStudio.test.ts --bundle --platform=node --format=esm --alias:@=./src --banner:js='globalThis.window=globalThis.window||{};' | node --input-type=module",
    "test": "npm run test:recall && npm run test:project"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@vercel/analytics": "^2.0.1",
    "epubjs": "^0.3.93",
    "framer-motion": "^12.40.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.11.2",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
